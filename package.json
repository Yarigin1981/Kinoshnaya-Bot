{
  "name": "kinoshnaya-telegram-bot",
  "version": "1.1.0",
  "description": "Telegram bot for Kinoshnaya channel - auto-posting with AI generation and channel monitoring",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate": "tsx src/scripts/generate-posts.ts",
    "post:now": "tsx src/scripts/post-now.ts",
    "auth:userbot": "tsx src/scripts/auth-userbot.ts",
    "monitor:once": "tsx src/scripts/monitor-once.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "input": "^1.0.1",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
